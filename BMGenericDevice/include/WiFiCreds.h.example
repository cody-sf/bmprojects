/**
 * WiFiCreds.h.example - build-time WiFi fallback for OTA.
 *
 * Copy this file to WiFiCreds.h (same folder) and fill in your network. That
 * copy is gitignored, so your real credentials never get committed or baked
 * into public GitHub-release binaries - it only affects images you build and
 * flash locally (USB or the *_ota network upload).
 *
 * The app's BLE provisioning still overrides these at runtime, so this is just
 * a convenience so a freshly flashed board joins the network on its own.
 */
#ifndef WIFI_CREDS_H
#define WIFI_CREDS_H

#define WIFI_CREDS_SSID  "YourNetworkName"
#define WIFI_CREDS_PASS  "YourNetworkPassword"

// ── Home Assistant / MQTT (signs only) ───────────────────────────────────────
// Optional: with MQTT_BROKER_HOST defined, keep-WiFi-alive builds (the signs)
// publish an MQTT-discovery light entity (on/off + brightness) to Home
// Assistant and mirror state changes back. Omit these defines to compile the
// bridge out. An IP or plain DNS name is preferred; ".local" is resolved via
// mDNS at connect time. Leave MQTT_USER empty to connect anonymously.
// #define MQTT_BROKER_HOST "192.168.1.10"
// #define MQTT_BROKER_PORT 1883
// #define MQTT_USER "mqtt-lights"
// #define MQTT_PASS "your-mqtt-password"

#endif  // WIFI_CREDS_H
